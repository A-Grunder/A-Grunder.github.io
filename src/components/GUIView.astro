---
import { PORTFOLIO_DATA } from "../data/portfolio";
import Neofetch from "./Neofetch.astro";

const { developer, skills, collabs } = PORTFOLIO_DATA;
---

<div
  id="view-gui"
  class="hidden flex-col space-y-6 font-mono text-xs md:text-sm"
>
  <!-- Top Neofetch System Summary Card -->
  <Neofetch />

  <!-- Main TUI Grid: Sidebar Directory Navigation + Main Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Sidebar Navigation Tree -->
    <aside class="lg:col-span-3 border border-(--border-color) bg-(--bg-card) p-4 space-y-4">
      <div class="text-(--accent) font-bold border-b border-(--border-color) pb-2 flex items-center justify-between">
        <span>📁 EXPLORER</span>
        <span class="text-[10px] text-(--fg-dim)">CONTENTS</span>
      </div>

      <nav class="space-y-1 font-mono text-xs">
        <a
          href="#gui-about"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--fg-bright) font-bold transition-colors"
        >
          <span class="text-yellow-400">📄</span> bio.txt (About Me)
        </a>
        <a
          href="#gui-skills"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--fg-bright) transition-colors"
        >
          <span class="text-emerald-400">⚙️</span> skills.sh (Skills)
        </a>
        <a
          href="#gui-collabs"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--fg-bright) transition-colors"
        >
          <span class="text-purple-400">🤝</span> collabs.md (Collabs)
        </a>
        <a
          href="#gui-github"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--fg-bright) transition-colors"
        >
          <span class="text-sky-400">🐙</span> github.sh (GitHub Stats)
        </a>
        <a
          href="#gui-contact"
          class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--fg-bright) transition-colors"
        >
          <span class="text-red-400">✉️</span> contact.txt (Contact)
        </a>
        <button
          type="button"
          id="gui-launch-pong"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-(--accent) font-bold transition-colors cursor-pointer border border-dashed border-(--border-color) mt-1"
        >
          <span>🕹️</span> pong.sh (Pong Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-snake"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-emerald-400 font-bold transition-colors cursor-pointer border border-dashed border-(--border-color) mt-1"
        >
          <span>🐍</span> snake.sh (Snake Arcade)
        </button>
        <button
          type="button"
          id="gui-launch-radio"
          class="w-full text-left gui-nav-item flex items-center gap-2 p-1.5 hover:bg-(--border-color) text-pink-400 font-bold transition-colors cursor-pointer border border-dashed border-(--border-color) mt-1"
        >
          <span>📻</span> radio.sh (Lo-Fi Radio)
        </button>
      </nav>

      <!-- Quick Metrics -->
      <div class="pt-4 border-t border-(--border-color) space-y-2 text-[11px]">
        <div class="text-(--fg-dim) font-bold uppercase tracking-wider text-[10px]">
          CONTENT SPEC
        </div>
        <div class="flex justify-between text-(--fg-main)">
          <span>Active Collabs:</span>
          <span class="font-bold text-(--fg-bright)">{collabs.length}</span>
        </div>
        <div class="flex justify-between text-(--fg-main)">
          <span>Skill Domains:</span>
          <span class="font-bold text-yellow-400">{skills.length}</span>
        </div>
        <div class="flex justify-between text-(--fg-main)">
          <span>Experience:</span>
          <span class="font-bold text-emerald-400">
            {developer.experience}+ Years
          </span>
        </div>
      </div>

      <!-- Quick GitHub Link -->
      <div class="pt-2">
        <a
          href={developer.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center block px-3 py-2 border border-(--border-color) bg-(--bg-main) hover:border-(--border-active) text-(--fg-bright) text-xs font-bold transition-colors items-center"
        >
          GitHub Profile ↗
        </a>
      </div>
      <div class="pt-0">
        <a
          href={developer.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center block px-3 py-1.5 border border-(--border-color) bg-(--bg-main) hover:border-(--border-active) text-(--fg-bright) text-xs font-bold transition-colors items-center"
        >
          Linkedin ↗
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="lg:col-span-9 space-y-8">
      <!-- Section 1: About Me -->
      <section
        id="gui-about"
        class="border border-(--border-color) bg-(--bg-card) p-4 sm:p-5 space-y-4"
      >
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-(--border-color) pb-3">
          <h2 class="text-xs sm:text-base font-bold text-(--fg-bright) flex items-center gap-1.5 sm:gap-2 truncate">
            <span class="text-(--accent)">></span> CAT BIO.TXT // ABOUT ME
          </h2>
          <span class="text-[10px] sm:text-xs text-(--fg-dim) shrink-0">
            [READ-ONLY]
          </span>
        </div>

        <p class="text-(--fg-main) leading-relaxed text-xs sm:text-sm">
          {developer.bio}
        </p>

        {developer.quote && (
          <blockquote class="p-3 border-l-2 border-(--accent) bg-(--bg-main) text-(--fg-dim) italic text-xs leading-relaxed">
            {developer.quote}
          </blockquote>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="p-3 border border-(--border-color) bg-(--bg-main) space-y-1">
            <span class="text-[10px] text-(--fg-dim) uppercase font-bold">
              {developer.focusType} FOCUS
            </span>
            <div class="text-xs text-(--accent) font-bold">
              {developer.focus}
            </div>
          </div>
          <div class="p-3 border border-(--border-color) bg-(--bg-main) space-y-1">
            <span class="text-[10px] text-(--fg-dim) uppercase font-bold">
              LOCATION
            </span>
            <div class="text-xs text-(--fg-bright) font-bold">
              📍 {developer.location}
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Skills -->
      <section
        id="gui-skills"
        class="border border-(--border-color) bg-(--bg-card) p-4 sm:p-5 space-y-4"
      >
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-(--border-color) pb-3">
          <h2 class="text-xs sm:text-base font-bold text-(--fg-bright) flex items-center gap-1.5 sm:gap-2 truncate">
            <span class="text-(--accent)">></span> ./SKILLS.SH // TECHNICAL
            PROFICIENCY
          </h2>
          <span class="text-[10px] sm:text-xs text-(--fg-dim) shrink-0">
            [PROFICIENCY METRICS]
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {skills.map((cat) => (
            <div class="border border-(--border-color) bg-(--bg-main) p-4 space-y-3">
              <div class="text-xs font-bold text-(--accent) flex items-center gap-2 border-b border-(--border-color) pb-2">
                <span>{cat.icon}</span>
                <span>{cat.category}</span>
              </div>

              <div class="space-y-2.5">
                {cat.skills.map((skill) => {
                  return (
                    <div class="space-y-1">
                      <div class="flex justify-between text-xs font-bold">
                        <span class="text-(--fg-bright)">{skill.name}</span>
                        <span class="text-(--fg-dim) text-[10px]">
                          {skill.experience}
                        </span>
                      </div>
                      <div class="flex items-center gap-2 text-xs">
                        <div class="flex-1 bg-(--bg-card) border border-(--border-color) h-4 overflow-hidden relative flex items-center px-1">
                          <div
                            class="h-full bg-(--fg-dim) opacity-40 absolute left-0 top-0"
                            style={`width: ${skill.level}%`}
                          />
                          <span class="relative z-10 text-[10px] text-(--fg-bright) font-mono">
                            {skill.level}%
                          </span>
                        </div>
                        <span class="text-[9px] px-1 bg-(--border-color) text-(--accent) font-bold w-16 text-center uppercase">
                          {skill.tag}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: Collabs (Collaborations) -->
      <!-- <section
        id="gui-collabs"
        class="border border-(--border-color) bg-(--bg-card) p-4 sm:p-5 space-y-4"
      >
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-(--border-color) pb-3">
          <h2 class="text-xs sm:text-base font-bold text-(--fg-bright) flex items-center gap-1.5 sm:gap-2 truncate">
            <span class="text-(--accent)">></span> CAT COLLABS.MD // TEAM
            COLLABORATIONS
          </h2>
          <span class="text-[10px] sm:text-xs text-(--fg-dim) shrink-0">
            [PARTNERSHIPS]
          </span>
        </div>

        <div class="space-y-4">
          {collabs.map((item) => (
            <div class="border border-(--border-color) bg-(--bg-main) p-5 space-y-3 hover:border-(--border-active) transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-(--border-color) pb-2">
                <h3 class="text-sm font-bold text-(--fg-bright) flex items-center gap-2">
                  <span>🤝</span> {item.title}
                </h3>
                <span class="text-[10px] px-2 py-0.5 border border-(--border-color) text-(--accent) uppercase font-bold">
                  {item.partnerType}
                </span>
              </div>

              {item.asciiLogo && <pre class="my-2 p-2.5 bg-(--bg-card) text-[10px] sm:text-xs text-(--fg-bright) overflow-x-auto leading-tight select-none border border-(--border-color) font-mono whitespace-pre">{item.asciiLogo}</pre>}

              <div class="text-xs">
                <span class="text-(--accent) font-bold">Partner Org:</span>{" "}
                <span class="text-(--fg-bright) font-bold">{item.partner}</span>
                <span class="mx-2 text-(--fg-dim)">|</span>
                <span class="text-(--accent) font-bold">Role:</span>{" "}
                <span class="text-emerald-400 font-bold">{item.role}</span>
                <span class="mx-2 text-(--fg-dim)">|</span>
                <span class="text-(--fg-dim)">{item.period}</span>
              </div>

              <p class="text-xs text-(--fg-main) leading-relaxed">
                {item.description}
              </p>

              <div class="space-y-1 pt-1">
                <span class="text-[10px] text-(--fg-dim) uppercase font-bold">
                  Key Contributions:
                </span>
                <ul class="list-disc list-inside text-xs text-(--fg-main) space-y-0.5">
                  {item.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-wrap items-center justify-between pt-3 border-t border-(--border-color) gap-2">
                <div class="flex flex-wrap gap-1">
                  {item.techStack.map((t) => (
                    <span class="text-[10px] px-1.5 py-0.5 bg-(--bg-card) text-(--fg-dim) border border-(--border-color)">
                      {t}
                    </span>
                  ))}
                </div>

                {item.link && (
                  <a
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-(--accent) hover:underline font-bold"
                  >
                    View Project ↗
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section> -->

      <!-- Section 4: Live GitHub Stats & Repositories -->
      <section
        id="gui-github"
        class="border border-(--border-color) bg-(--bg-card) p-4 sm:p-5 space-y-4"
      >
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-(--border-color) pb-3">
          <h2 class="text-xs sm:text-base font-bold text-(--fg-bright) flex items-center gap-1.5 sm:gap-2 truncate">
            <span class="text-(--accent)">></span> CAT GITHUB.SH // REPOSITORIES
            & METRICS
          </h2>
          <span class="text-[10px] sm:text-xs text-emerald-400 font-bold flex items-center gap-1.5 shrink-0">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            LIVE REST API
          </span>
        </div>

        <div id="gui-gh-loading" class="text-xs text-(--fg-dim) py-2 font-mono">
          Connecting to GitHub API & caching statistics...
        </div>

        <div id="gui-gh-content" class="hidden space-y-4 font-mono">
          <!-- Metric Counter Cards -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
            <div class="border border-(--border-color) bg-(--bg-main) p-2 sm:p-3 text-center">
              <div class="text-[9px] sm:text-[10px] text-(--fg-dim) font-bold truncate">
                TOTAL STARS ⭐
              </div>
              <div
                id="gui-gh-stars"
                class="text-base sm:text-xl font-bold text-yellow-400 mt-0.5 sm:mt-1"
              >
                0
              </div>
            </div>
            <div class="border border-(--border-color) bg-(--bg-main) p-2 sm:p-3 text-center">
              <div class="text-[9px] sm:text-[10px] text-(--fg-dim) font-bold truncate">
                TOTAL FORKS 🍴
              </div>
              <div
                id="gui-gh-forks"
                class="text-base sm:text-xl font-bold text-cyan-400 mt-0.5 sm:mt-1"
              >
                0
              </div>
            </div>
            <div class="border border-(--border-color) bg-(--bg-main) p-2 sm:p-3 text-center">
              <div class="text-[9px] sm:text-[10px] text-(--fg-dim) font-bold truncate">
                PUBLIC REPOS 📦
              </div>
              <div
                id="gui-gh-repos"
                class="text-base sm:text-xl font-bold text-emerald-400 mt-0.5 sm:mt-1"
              >
                0
              </div>
            </div>
            <div class="border border-(--border-color) bg-(--bg-main) p-2 sm:p-3 text-center">
              <div class="text-[9px] sm:text-[10px] text-(--fg-dim) font-bold truncate">
                FOLLOWERS 👥
              </div>
              <div
                id="gui-gh-followers"
                class="text-base sm:text-xl font-bold text-purple-400 mt-0.5 sm:mt-1"
              >
                0
              </div>
            </div>
          </div>

          <!-- Top Languages Bar -->
          <div class="border border-(--border-color) bg-(--bg-main) p-3 space-y-2">
            <div class="text-[10px] text-(--fg-dim) font-bold uppercase tracking-wider">
              Primary Programming Languages
            </div>
            <div
              id="gui-gh-lang-list"
              class="flex flex-wrap gap-2 text-xs"
            ></div>
          </div>

          <!-- Top Repositories Grid -->
          <div class="space-y-2">
            <div class="text-[10px] text-(--fg-dim) font-bold uppercase tracking-wider">
              Featured Repositories
            </div>
            <div
              id="gui-gh-repos-list"
              class="grid grid-cols-1 sm:grid-cols-2 gap-3"
            ></div>
          </div>
        </div>
      </section>

      <!-- Section 5: Contact -->
      <section
        id="gui-contact"
        class="border border-(--border-color) bg-(--bg-card) p-4 sm:p-5 space-y-4"
      >
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2 border-b border-(--border-color) pb-3">
          <h2 class="text-xs sm:text-base font-bold text-(--fg-bright) flex items-center gap-1.5 sm:gap-2 truncate">
            <span class="text-(--accent)">></span> TRANSMIT MAIL // CONTACT
          </h2>
          <span class="text-[10px] sm:text-xs text-(--fg-dim) shrink-0">
            [INQUIRIES]
          </span>
        </div>

        <form
          id="contact-form"
          data-recipient-email={developer.email}
          class="space-y-4"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label
                for="contact-name"
                class="text-xs text-(--fg-bright) font-bold block"
              >
                NAME:
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Linus Torvalds"
                class="w-full bg-(--bg-main) text-(--fg-bright) border border-(--border-color) focus:border-(--border-active) p-2 text-xs font-mono focus:outline-none"
              />
            </div>
            <div class="space-y-1">
              <label
                for="contact-email"
                class="text-xs text-(--fg-bright) font-bold block"
              >
                EMAIL:
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="linus@kernel.org"
                class="w-full bg-(--bg-main) text-(--fg-bright) border border-(--border-color) focus:border-(--border-active) p-2 text-xs font-mono focus:outline-none"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label
              for="contact-message"
              class="text-xs text-(--fg-bright) font-bold block"
            >
              MESSAGE / COLLAB PROPOSAL:
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Enter your message or collaboration inquiry..."
              class="w-full bg-(--bg-main) text-(--fg-bright) border border-(--border-color) focus:border-(--border-active) p-2 text-xs font-mono focus:outline-none resize-none"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2">
            <span id="form-status" class="text-xs font-bold hidden"></span>
            <button
              id="contact-submit-btn"
              type="submit"
              class="px-5 py-2 border border-(--border-active) bg-(--border-color) hover:bg-(--border-active) text-(--fg-bright) font-bold text-xs cursor-pointer transition-colors ml-auto"
            >
              <span id="btn-text">SEND PAYLOAD [ENTER]</span>
            </button>
          </div>
        </form>
      </section>
    </div>
  </div>
</div>

<script>
  import confetti from "canvas-confetti";
  import { playSuccessSound } from "../utils/sound";
  import { PORTFOLIO_DATA } from "../data/portfolio";
  import { fetchGitHubStats } from "../utils/github";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusMsg = document.getElementById("form-status");
    const submitBtn = document.getElementById(
      "contact-submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const recipientEmail = PORTFOLIO_DATA.developer.email;

    // Fetch and populate live GitHub stats
    initGitHubStats();

    async function initGitHubStats() {
      const loadingEl = document.getElementById("gui-gh-loading");
      const contentEl = document.getElementById("gui-gh-content");
      const starsEl = document.getElementById("gui-gh-stars");
      const forksEl = document.getElementById("gui-gh-forks");
      const reposEl = document.getElementById("gui-gh-repos");
      const followersEl = document.getElementById("gui-gh-followers");
      const langListEl = document.getElementById("gui-gh-lang-list");
      const reposListEl = document.getElementById("gui-gh-repos-list");

      const stats = await fetchGitHubStats();
      if (!stats) {
        if (loadingEl)
          loadingEl.textContent =
            "GitHub metrics temporarily offline / rate-limited.";
        return;
      }

      if (loadingEl) loadingEl.classList.add("hidden");
      if (contentEl) contentEl.classList.remove("hidden");

      if (starsEl) starsEl.textContent = String(stats.totalStars);
      if (forksEl) forksEl.textContent = String(stats.totalForks);
      if (reposEl) reposEl.textContent = String(stats.publicRepos);
      if (followersEl) followersEl.textContent = String(stats.followers);

      if (langListEl) {
        langListEl.innerHTML = "";
        stats.topLanguages.forEach((lang) => {
          const badge = document.createElement("span");
          badge.className =
            "px-2 py-1 bg-(--bg-card) border border-(--border-color) text-(--fg-bright) flex items-center gap-1.5";
          badge.innerHTML = `<span class="text-(--accent) font-bold">${lang.name}</span> <span class="text-(--fg-dim) text-[10px]">(${lang.percentage}%)</span>`;
          langListEl.appendChild(badge);
        });
      }

      if (reposListEl) {
        reposListEl.innerHTML = "";
        stats.topRepos.forEach((repo) => {
          const card = document.createElement("a");
          card.href = repo.url;
          card.target = "_blank";
          card.rel = "noopener noreferrer";
          card.className =
            "border border-(--border-color) bg-(--bg-main) p-3 hover:border-(--accent) transition-all flex flex-col justify-between block group";
          card.innerHTML = `
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-(--border-color) pb-1.5 mb-1.5">
                <span class="text-xs font-bold text-(--fg-bright) group-hover:text-(--accent) truncate">📦 ${repo.name}</span>
                <span class="text-[10px] text-(--accent) font-bold shrink-0">⭐ ${repo.stars}</span>
              </div>
              <p class="text-[11px] text-(--fg-dim) line-clamp-2 leading-tight">${repo.description}</p>
            </div>
            <div class="flex flex-wrap items-center justify-between text-[10px] text-(--fg-dim) pt-2 mt-2 border-t border-(--border-color) gap-1">
              <span class="text-emerald-400 font-bold">${repo.language}</span>
              <span class="truncate">Updated ${repo.updatedAt} ↗</span>
            </div>
          `;
          reposListEl.appendChild(card);
        });
      }
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nameInput = document.getElementById(
        "contact-name",
      ) as HTMLInputElement;
      const emailInput = document.getElementById(
        "contact-email",
      ) as HTMLInputElement;
      const messageInput = document.getElementById(
        "contact-message",
      ) as HTMLTextAreaElement;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();

      if (!name || !email || !message) return;

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (btnText) btnText.textContent = "TRANSMITTING...";
      if (statusMsg) {
        statusMsg.className = "text-xs font-bold text-yellow-400 block";
        statusMsg.textContent = "⏳ Encrypting & dispatching email payload...";
      }

      try {
        const response = await fetch(
          `https://formsubmit.co/ajax/${recipientEmail}`,
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({
              name,
              email,
              message,
              _subject: `Portfolio Contact from ${name}`,
              _captcha: "false",
            }),
          },
        );

        if (response.ok) {
          playSuccessSound();

          confetti({
            particleCount: 80,
            spread: 60,
            origin: { y: 0.7 },
            colors: ["#00ff66", "#00f0ff", "#ffb000", "#bd93f9"],
          });

          if (statusMsg) {
            statusMsg.className = "text-xs font-bold text-emerald-400 block";
            statusMsg.textContent =
              "✓ Message payload successfully transmitted!";
            setTimeout(() => {
              statusMsg.className = "text-xs font-bold hidden";
              statusMsg.textContent = "";
            }, 7000);
          }
          form.reset();
        } else {
          throw new Error(`HTTP ${response.status}`);
        }
      } catch (err) {
        if (statusMsg) {
          statusMsg.className = "text-xs font-bold text-rose-400 block";
          statusMsg.textContent =
            "✖ Transmission failed. Please try again later.";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = "SEND PAYLOAD [ENTER]";
      }
    });

    const bindLaunchBtn = (id: string, callback: () => void) => {
      const el = document.getElementById(id);
      if (!el) return;
      let lastTrigger = 0;
      const handler = () => {
        const now = Date.now();
        if (now - lastTrigger < 300) return; // Prevent double trigger
        lastTrigger = now;
        callback();
      };
      el.addEventListener("click", handler);
      el.addEventListener(
        "touchstart",
        (e) => {
          e.preventDefault();
          handler();
        },
        { passive: false },
      );
    };

    bindLaunchBtn("gui-launch-pong", () => {
      const win = window as unknown as { togglePong?: (f?: boolean) => void };
      if (win.togglePong) {
        win.togglePong(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-snake", () => {
      const win = window as unknown as { toggleSnake?: (f?: boolean) => void };
      if (win.toggleSnake) {
        win.toggleSnake(true);
        playSuccessSound();
      }
    });

    bindLaunchBtn("gui-launch-radio", () => {
      const win = window as unknown as {
        radioEngine?: { toggleModal: (f?: boolean) => void };
      };
      if (win.radioEngine) {
        win.radioEngine.toggleModal(true);
        playSuccessSound();
      }
    });
  });
</script>
